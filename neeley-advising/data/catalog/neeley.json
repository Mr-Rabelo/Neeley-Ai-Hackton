  "policies": [
    {
      "id": "total-hours",
      "text": "At least 120 semester hours are required for a bachelor's degree.",
      "value": 120,
      "sourceId": "S1",
      "page": 204
    },
    {
      "id": "advanced-hours",
      "text": "At least 36 of the total hours must be advanced courses numbered 30000 or above, completed at TCU.",
      "value": 36,
      "sourceId": "S1",
      "page": 204
    },
    {
      "id": "residence",
      "text": "At least 45 semester hours must be completed in residence at TCU, and all courses in the final semester must be taken at TCU.",
      "value": 45,
      "sourceId": "S1",
      "page": 204
    },
    {
      "id": "bba-gpa",
      "text": "A TCU cumulative GPA of at least 2.50 and a major GPA of at least 2.5 are required to graduate with a BBA.",
      "value": 2.5,
      "sourceId": "S1",
      "page": 586
    },
    {
      "id": "advance-gpa",
      "text": "To advance into a Neeley major: TCU cumulative GPA of 3.00 or higher and lower-division GPA of 2.75 or higher; all lower-division requirements completed or enrolled.",
      "cumulative": 3.0,
      "lowerDivision": 2.75,
      "sourceId": "S2",
      "page": 4
    },
    {
      "id": "first-year",
      "text": "Students entering as business must complete at least 24 credit hours in the first year at TCU with a 2.75 GPA, and demonstrate Excel and PowerPoint competency (Microsoft Specialist certification, basic level).",
      "hours": 24,
      "gpa": 2.75,
      "sourceId": "S2",
      "page": 4
    },
    {
      "id": "internal-transfer",
      "text": "Internal transfers into business are reviewed once a year; a GPA below 3.25 is unlikely to be admitted. Admission is competitive and not guaranteed.",
      "gpa": 3.25,
      "sourceId": "S1",
      "page": 586
    },
    {
      "id": "pnc",
      "text": "Business students may take up to 6 semester hours pass/no-credit. No Neeley course and no lower-division business core course may be taken P/NC.",
      "maxHours": 6,
      "sourceId": "S2",
      "page": 5
    },
    {
      "id": "transfer-limit",
      "text": "Once enrolled at TCU, no more than 4 courses (16 hours) may transfer from other institutions, with prior written approval from the Neeley Academic Advising Center. Lower-division sequence, upper-division core and major courses must be taken at TCU.",
      "maxHours": 16,
      "sourceId": "S2",
      "page": 5
    },
    {
      "id": "prereq-grade",
      "text": "A grade of C- or better is required in any course serving as a prerequisite for a course in the Neeley School unless the course states otherwise.",
      "sourceId": "S1",
      "page": null,
      "needsReview": true
    },
    {
      "id": "appeal",
      "text": "Exceptions to any Neeley School policy require a formal appeal to the assistant dean of undergraduate programs.",
      "sourceId": "S2",
      "page": 6
    },
    {
      "id": "double-major",
      "text": "Students may double major in any combination of business disciplines; the number of hours needed must be confirmed with the Neeley Academic Advising Center.",
      "sourceId": "S1",
      "page": 588,
      "advisorRequired": true
    },
    {
      "id": "course-load",
      "text": "Maximum credit load per term was not found in the supplied documents.",
      "sourceId": null,
      "unverified": true
    }
  ],
