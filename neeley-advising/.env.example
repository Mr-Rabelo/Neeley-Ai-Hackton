# Copy to .env.local and fill in. Never commit real values.

# Claude (required for AI profiling, recommendations and chat)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
ANTHROPIC_FAST_MODEL=claude-haiku-5-5

# Supabase (optional: without it, requests/feedback are kept in memory only)
NEXT_PUBLIC_SUPABASE_URL=https://inlbkkuzvxaqltpaxcmj.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Twilio voice + SMS (optional until the phone assistant is switched on)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
ADVISOR_PHONE_NUMBER=

# Public base URL used to validate Twilio webhook signatures (e.g. https://your-app.vercel.app)
APP_BASE_URL=

# Public display values
NEXT_PUBLIC_AI_PHONE_DISPLAY=
NEXT_PUBLIC_ADVISOR_SCHEDULING_URL=
