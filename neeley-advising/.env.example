# Copy to .env.local and fill in. Never commit real values.

# Claude (required for AI profiling, recommendations and chat)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
ANTHROPIC_FAST_MODEL=claude-haiku-5-5

# Supabase (optional: without it, requests/feedback are kept in memory only)
NEXT_PUBLIC_SUPABASE_URL=https://inlbkkuzvxaqltpaxcmj.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Vapi browser voice calls
NEXT_PUBLIC_VAPI_PUBLIC_KEY=
NEXT_PUBLIC_VAPI_ASSISTANT_ID=
VAPI_SERVER_SECRET=
# Only for `npm run vapi:sync` (pushes vapi/ to the assistant); not needed by the deployed app
VAPI_PRIVATE_KEY=
VAPI_TOOL_CREDENTIAL_ID=

# Optional Twilio SMS only (used to text a sign-in link after consent)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Public base URL used in SMS links (e.g. https://your-app.vercel.app)
APP_BASE_URL=

# Public display values
NEXT_PUBLIC_ADVISOR_SCHEDULING_URL=
