# Copy to .env.local and fill in. Never commit real values.

# Claude (required for AI profiling, recommendations and chat)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
ANTHROPIC_FAST_MODEL=claude-haiku-5-5

# Supabase (optional: without it, requests/feedback are kept in memory only)
NEXT_PUBLIC_SUPABASE_URL=https://inlbkkuzvxaqltpaxcmj.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Voice (Vapi, browser calls)
NEXT_PUBLIC_VAPI_PUBLIC_KEY=
NEXT_PUBLIC_VAPI_ASSISTANT_ID=
# Server-only shared secret that Vapi sends in the x-vapi-secret header to /api/vapi/tools
VAPI_SERVER_SECRET=

# Twilio: optional, SMS only (the consent-based "text me the sign-in link" feature)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
# Public base URL used in the texted link (e.g. https://your-app.vercel.app)
APP_BASE_URL=

# Advisor queue passcode (required to open /advisor in production)
ADVISOR_PASSCODE=

# Public display values
NEXT_PUBLIC_ADVISOR_SCHEDULING_URL=
